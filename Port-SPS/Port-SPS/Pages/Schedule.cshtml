<style>
.page-schedule {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
}

.schedule-header {
    text-align: center;
    margin-bottom: 2rem;
}

.schedule-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1a3a52;
    margin-bottom: 0.5rem;
}

.schedule-subtitle {
    font-size: 1.1rem;
    color: #6b7280;
}

.schedule-container {
    background: white;
    padding: 1.5rem;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    overflow-x: auto;
    margin-bottom: 2rem;
}

.schedule-table {
    width: 100%;
    border-collapse: collapse;
}

.schedule-table thead {
    background: linear-gradient(135deg, #1a3a52 0%, #2d5a7b 100%);
    color: white;
}

.schedule-table th {
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    border: 1px solid #e5e7eb;
}

.time-header {
    min-width: 100px;
}

.schedule-table td {
    padding: 1rem;
    border: 1px solid #e5e7eb;
    font-size: 0.9rem;
}

.time-slot {
    background: #f9fafb;
    font-weight: 600;
    color: #1a3a52;
    min-width: 100px;
}

.subject {
    background: #f3f4f6;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.subject strong {
    color: #0066cc;
}

.subject .teacher {
    font-size: 0.8rem;
    color: #6b7280;
}

.subject .room {
    font-size: 0.8rem;
    color: #9ca3af;
    font-style: italic;
}

.schedule-table tbody tr:hover {
    background: rgba(0, 102, 204, 0.05);
}

.schedule-notes {
    background: #dbeafe;
    border: 2px solid #0066cc;
    padding: 1.5rem;
    border-radius: 0.75rem;
}

.schedule-notes h3 {
    color: #0052a3;
    margin: 0 0 1rem 0;
    font-weight: 600;
}

.schedule-notes ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.schedule-notes li {
    color: #0052a3;
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
}

.schedule-notes li::before {
    content: "→";
    position: absolute;
    left: 0;
}

@media (max-width: 768px) {
    .schedule-header h1 {
        font-size: 1.75rem;
    }

    .schedule-container {
        padding: 1rem;
        font-size: 0.85rem;
    }

    .schedule-table th,
    .schedule-table td {
        padding: 0.75rem 0.5rem;
    }

    .subject .teacher,
    .subject .room {
        display: none;
    }
}
