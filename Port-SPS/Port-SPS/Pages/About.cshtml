@page
@using Port_SPS.Pages
@model AboutModel
@{
    ViewData["Title"] = "O škole - SPS Trutnov";
}

<div class="page-container">
    <h1 class="page-title">ℹ️ O naší škole</h1>

    <section class="content-section">
        <h2>Střední průmyslová škola Trutnov</h2>
        <p class="intro-text">
            Vítejte na oficiálním portálu Střední průmyslové školy Trutnov. Jsme prestižní vzdělávací institucí 
            zaměřenou na výuku moderních technologií a řemesel.
        </p>
    </section>

    <section class="content-section">
        <h2>Naše mise</h2>
        <div class="card-grid">
            <div class="info-card">
                <div class="card-icon">🎓</div>
                <h3>Kvalitní vzdělání</h3>
                <p>Poskytujeme moderní a relevantní vzdělání se zaměřením na praktické dovednosti.</p>
            </div>
            <div class="info-card">
                <div class="card-icon">🔧</div>
                <h3>Praktická praxe</h3>
                <p>Naši studenti získávají cenné zkušenosti v reálných pracovních prostředích.</p>
            </div>
            <div class="info-card">
                <div class="card-icon">💼</div>
                <h3>Kariérní perspektivy</h3>
                <p>Pomáháme našim studentům najít vyhovující zaměstnání nebo pokračovat v dalším studiu.</p>
            </div>
        </div>
    </section>

    <section class="content-section">
        <h2>Obory vzdělání</h2>
        <ul class="feature-list">
            <li>📱 Informační technologie</li>
            <li>⚙️ Strojnictví a automechanika</li>
            <li>🏗️ Stavebnictví</li>
            <li>💡 Elektrotechnika</li>
            <li>👨‍💼 Obchod a služby</li>
            <li>🎨 Grafika a design</li>
        </ul>
    </section>

    <section class="content-section">
        <h2>Naše škola v číslech</h2>
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-number">500+</div>
                <div class="stat-label">Studentů</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">50+</div>
                <div class="stat-label">Učitelů</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">6</div>
                <div class="stat-label">Oborů</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">30+</div>
                <div class="stat-label">Let tradice</div>
            </div>
        </div>
    </section>

    <section class="content-section">
        <h2>Vybavení a zařízení</h2>
        <p>
            Naše škola je vybavena moderními laboratořemi, počítačovými pracovnami, dílnami a dalšími 
            prostředky potřebnými pro kvalitní vzdělání. Všechny prostory jsou pravidelně aktualizovány 
            v souladu s nejnovějšími trendy v oboru.
        </p>
    </section>

    <section class="content-section call-to-action">
        <h2>Máte zájem o naši školu?</h2>
        <p>Spojte se s námi prostřednictvím kontaktních údajů na stránce Kontakty.</p>
        <a asp-page="/Contact" class="btn-primary">📞 Přejít na kontakty</a>
    </section>
</div>

<style>
.page-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
}

.page-title {
    font-size: 2.5rem;
    color: #1a3a52;
    text-align: center;
    margin-bottom: 3rem;
    font-weight: bold;
}

.content-section {
    background: #f8f9fa;
    padding: 2rem;
    margin-bottom: 2rem;
    border-radius: 8px;
    border-left: 4px solid #0066cc;
}

.intro-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.info-card {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.info-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
}

.card-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.info-card h3 {
    color: #0066cc;
    margin-bottom: 0.5rem;
}

.feature-list {
    list-style: none;
    padding: 0;
}

.feature-list li {
    padding: 0.75rem 0;
    font-size: 1.05rem;
    color: #333;
    border-bottom: 1px solid #e0e0e0;
}

.feature-list li:last-child {
    border-bottom: none;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
}

.stat-box {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.stat-number {
    font-size: 2rem;
    font-weight: bold;
    color: #0066cc;
}

.stat-label {
    font-size: 0.95rem;
    color: #666;
    margin-top: 0.5rem;
}

.call-to-action {
    text-align: center;
    background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
    color: white;
    border-left-color: #004080;
}

.call-to-action h2,
.call-to-action p {
    color: white;
}

.btn-primary {
    display: inline-block;
    background: white;
    color: #0066cc;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    margin-top: 1rem;
    transition: background 0.3s ease;
}

.btn-primary:hover {
    background: #f0f0f0;
}
</style>
