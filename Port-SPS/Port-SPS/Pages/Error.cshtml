@page
@using Port_SPS.Pages
@model ErrorModel
@{
    ViewData["Title"] = "Chyba";
}

<div class="container mt-5">
    <h1 class="text-danger">Chyba!</h1>
    <h2 class="text-danger">Při zpracování vaší žádosti došlo k chybě.</h2>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>ID požadavku:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <p>Kontaktujte prosím správce, pokud problém přetrvává.</p>
    <a asp-page="/Index" class="btn btn-primary mt-3">Zpět na úvodní stránku</a>
</div>
