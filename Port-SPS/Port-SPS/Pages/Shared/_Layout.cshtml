<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portál SPS Trutnov</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Port_SPS.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <div class="logo">
                <h1>📚 SPS Trutnov</h1>
                <p>Školní portál</p>
            </div>
            <div class="user-info">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <span class="user-greeting">Dobrý den, @User.Identity.Name!</span>
                    <form method="post" asp-page="/Auth/Logout">
                        <button type="submit" class="logout-btn">Odhlásit se</button>
                    </form>
                }
                else
                {
                    <a href="/Auth/Login" style="color: white; text-decoration: none;">Přihlášení</a>
                }
            </div>
        </div>
    </header>

    <!-- Navigation -->
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <nav class="nav-menu">
            <div class="nav-container">
                <a asp-page="/Dashboard" class="nav-link">📊 Přehled</a>
                <a asp-page="/Schedule" class="nav-link">🗓️ Rozvrh</a>
                <a asp-page="/Grades" class="nav-link">📈 Známky</a>
                <a asp-page="/Messages" class="nav-link">💬 Zprávy</a>
                <a asp-page="/Classes" class="nav-link">👥 Třídy</a>
                <a asp-page="/Announcements" class="nav-link">📢 Oznámení</a>
                <a asp-page="/Teachers" class="nav-link">👨‍🏫 Učitelé</a>
                <a asp-page="/Materials" class="nav-link">📚 Materiály</a>
                <a asp-page="/Profile/Index" class="nav-link">👤 Profil</a>
            </div>
        </nav>
    }

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2026 Střední průmyslová škola Trutnov. Všechna práva vyhrazena.</p>
            <div class="footer-links">
                <a href="#">Ochrana osobních údajů</a> | 
                <a href="#">Podmínky používání</a> | 
                <a href="#">Kontakt</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
