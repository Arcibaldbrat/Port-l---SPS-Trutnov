<style>
.page-grades {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
}

.grades-header {
    text-align: center;
    margin-bottom: 2rem;
}

.grades-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1a3a52;
    margin-bottom: 0.5rem;
}

.grades-subtitle {
    font-size: 1.1rem;
    color: #6b7280;
}

.grades-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.summary-card {
    background: linear-gradient(135deg, #0066cc 0%, #004da6 100%);
    color: white;
    padding: 1.5rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 4px 15px rgba(0, 102, 204, 0.2);
    animation: slideInUp 0.5s ease-out;
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.summary-icon {
    font-size: 2rem;
}

.summary-info h3 {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.95;
}

.summary-value {
    margin: 0.25rem 0 0 0;
    font-size: 1.5rem;
    font-weight: 700;
}

.grades-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
}

.subject-card {
    background: white;
    padding: 1.5rem;
    border-radius: 0.75rem;
    border-left: 5px solid #0066cc;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.subject-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
}

.subject-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #e5e7eb;
}

.subject-card h2 {
    color: #1a3a52;
    font-size: 1.25rem;
    margin: 0;
}

.average-badge {
    background: #0066cc;
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 0.375rem;
    font-weight: 700;
    font-size: 1.1rem;
}

.average-badge.excellent {
    background: #10b981;
}

.grades-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.grade-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}

.grade-item:last-child {
    border-bottom: none;
}

.grade-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
}

.grade-title {
    color: #1f2937;
    font-weight: 500;
    font-size: 0.95rem;
}

.grade-date {
    color: #9ca3af;
    font-size: 0.8rem;
}

.grade-value {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-weight: 700;
    color: white;
    font-size: 1rem;
}

.grade-1 {
    background: #10b981;
}

.grade-2 {
    background: #f59e0b;
}

.grade-3 {
    background: #ef4444;
}

@media (max-width: 768px) {
    .grades-header h1 {
        font-size: 1.75rem;
    }

    .grades-summary {
        grid-template-columns: repeat(2, 1fr);
    }

    .summary-card {
        padding: 1rem;
    }

    .grades-container {
        grid-template-columns: 1fr;
    }
}
        </ul>
