@page
@using Port_SPS.Pages.Auth
@model RegisterModel

<h2>Registrace</h2>

<form method="post">
    <div>
        <label for="firstName">Jméno:</label>
        <input type="text" id="firstName" name="Input.FirstName" required />
    </div>

    <div>
        <label for="lastName">Příjmení:</label>
        <input type="text" id="lastName" name="Input.LastName" required />
    </div>

    <div>
        <label for="email">Email:</label>
        <input type="email" id="email" name="Input.Email" required />
        <small>Musíte použít školní email s doménou @@spstrutnov.cz</small>
    </div>

    <div>
        <label for="userRole">Vaše role:</label>
        <select id="userRole" name="Input.UserRole" required>
            <option value="">-- Vyberte roli --</option>
            <option value="Student">Student/Studentka</option>
            <option value="Teacher">Učitel/Učitelka</option>
        </select>
    </div>

    <div>
        <label for="password">Heslo:</label>
        <input type="password" id="password" name="Input.Password" required />
    </div>

    <div>
        <label for="confirmPassword">Potvrzení hesla:</label>
        <input type="password" id="confirmPassword" name="Input.ConfirmPassword" required />
    </div>

    <button type="submit">Registrovat se</button>
</form>

<p>Již máte účet? <a asp-page="./Login">Přihlaste se zde</a></p>
