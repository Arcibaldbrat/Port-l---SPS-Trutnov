@page
@using Port_SPS.Pages.Auth
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registrace potvrzena";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">Registrace zaslána!</h4>
                <p>Vaš účet pro <strong>@Model.Email</strong> byl vytvořen a čeká na schválení správce školy.</p>
                <hr />
                <p class="mb-0">
                    Jakmile bude váš účet schválen, budete moci se přihlásit. 
                    <a asp-page="./Login">Zpět na přihlášení</a>
                </p>
            </div>
        </div>
    </div>
</div>
