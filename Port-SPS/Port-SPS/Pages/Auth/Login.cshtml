@page
@using Port_SPS.Pages.Auth
@model LoginModel

<h2>Přihlášení</h2>

<form method="post">
    <div>
        <label for="email">Email:</label>
        <input type="email" id="email" name="Input.Email" required />
    </div>

    <div>
        <label for="password">Heslo:</label>
        <input type="password" id="password" name="Input.Password" required />
    </div>

    <div>
        <label for="rememberMe">
            <input type="checkbox" id="rememberMe" name="Input.RememberMe" />
            Pamatuj si mě
        </label>
    </div>

    <button type="submit">Přihlásit se</button>
</form>

<p>
    Nemáte účet? <a asp-page="./Register">Zaregistrujte se zde</a>
</p>
