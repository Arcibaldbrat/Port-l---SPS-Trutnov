@page
@using Port_SPS.Pages
@model MessagesModel
@{
    ViewData["Title"] = "Zprávy - SPS Trutnov";
}

<div class="page-messages">
    <div class="messages-header">
        <h1>💬 Zprávy</h1>
        <p class="messages-subtitle">Komunikujte s učiteli a spolužáky</p>
    </div>

    <div class="messages-container">
        <div class="messages-sidebar">
            <div class="sidebar-header">
                <h3>Konverzace</h3>
                <button class="btn-new-message">✉️ Nová zpráva</button>
            </div>

            <ul class="conversations-list">
                <li class="conversation active">
                    <div class="conv-avatar">📚</div>
                    <div class="conv-details">
                        <span class="conv-name">Ing. Svoboda</span>
                        <span class="conv-preview">Máte úkol na příště...</span>
                    </div>
                    <span class="unread-badge">1</span>
                </li>
                <li class="conversation">
                    <div class="conv-avatar">👨‍🏫</div>
                    <div class="conv-details">
                        <span class="conv-name">Mgr. Nováková</span>
                        <span class="conv-preview">Vrátila jsem vaši esej</span>
                    </div>
                    <span class="unread-badge">2</span>
                </li>
                <li class="conversation">
                    <div class="conv-avatar">💻</div>
                    <div class="conv-details">
                        <span class="conv-name">Ing. Dvořák</span>
                        <span class="conv-preview">Dobrá práce na projektu</span>
                    </div>
                </li>
                <li class="conversation">
                    <div class="conv-avatar">👩‍💼</div>
                    <div class="conv-details">
                        <span class="conv-name">Vedení školy</span>
                        <span class="conv-preview">Oznámení o provozu školy</span>
                    </div>
                </li>
                <li class="conversation">
                    <div class="conv-avatar">🏫</div>
                    <div class="conv-details">
                        <span class="conv-name">Sekretariát</span>
                        <span class="conv-preview">Zaplacení školného</span>
                    </div>
                </li>
                <li class="conversation">
                    <div class="conv-avatar">📖</div>
                    <div class="conv-details">
                        <span class="conv-name">Knihovna</span>
                        <span class="conv-preview">Návrat materiálů do konce měsíce</span>
                    </div>
                </li>
            </ul>
        </div>

        <div class="messages-main">
            <div class="messages-header-main">
                <div class="conversation-header">
                    <h2>Ing. Svoboda</h2>
                    <p class="contact-info">Lektor matematiky | Poslední aktivita: dnes 15:30</p>
                </div>
            </div>

            <div class="messages-list">
                <div class="message received">
                    <div class="message-avatar">📚</div>
                    <div class="message-content">
                        <p>Ahoj! Jak se vede s domácím úkolem na funkce?</p>
                        <span class="message-time">10:15</span>
                    </div>
                </div>

                <div class="message sent">
                    <div class="message-content">
                        <p>Ahoj pane učiteli! Skoro jsem hotov, jen bych měl jednu otázku na příklad 5.</p>
                        <span class="message-time">10:30</span>
                    </div>
                </div>

                <div class="message received">
                    <div class="message-avatar">📚</div>
                    <div class="message-content">
                        <p>No samozřejmě! U příkladu 5 vychází ze zásady, že se jedná o klesající funkci. Zkus si ji nakreslit do grafu.</p>
                        <span class="message-time">10:35</span>
                    </div>
                </div>

                <div class="message sent">
                    <div class="message-content">
                        <p>Aha, teď to vidím! Díky za radu! 👍</p>
                        <span class="message-time">10:40</span>
                    </div>
                </div>

                <div class="message received">
                    <div class="message-avatar">📚</div>
                    <div class="message-content">
                        <p>Rád se stalo! Máte úkol na příště - příklady 1-10 ze strany 45. Deadline je pátek.</p>
                        <span class="message-time">11:00</span>
                    </div>
                </div>
            </div>

            <div class="message-input">
                <div class="input-group">
                    <input type="text" placeholder="Napište zprávu...">
                    <button class="btn-send">➤ Odeslat</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.page-messages {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    height: 80vh;
    display: flex;
    flex-direction: column;
}

.messages-header {
    text-align: center;
    margin-bottom: 1.5rem;
}

.messages-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #1a3a52;
    margin-bottom: 0.25rem;
}

.messages-subtitle {
    font-size: 1rem;
    color: #6b7280;
}

.messages-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.5rem;
    flex: 1;
    background: white;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    overflow: hidden;
}

.messages-sidebar {
    background: #f9fafb;
    border-right: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.sidebar-header {
    padding: 1.5rem;
    border-bottom: 2px solid #e5e7eb;
}

.sidebar-header h3 {
    margin: 0 0 1rem 0;
    color: #1a3a52;
    font-size: 1.1rem;
}

.btn-new-message {
    width: 100%;
    background: #0066cc;
    color: white;
    border: none;
    padding: 0.75rem;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-new-message:hover {
    background: #0052a3;
    transform: translateY(-2px);
}

.conversations-list {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-y: auto;
    flex: 1;
}

.conversation {
    padding: 1rem;
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
}

.conversation:hover {
    background: #f3f4f6;
}

.conversation.active {
    background: linear-gradient(135deg, #dbeafe 0%, #fff 100%);
    border-left: 4px solid #0066cc;
    padding-left: calc(1rem - 4px);
}

.conv-avatar {
    font-size: 1.5rem;
    min-width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5e7eb;
    border-radius: 50%;
}

.conv-details {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.conv-name {
    font-weight: 600;
    color: #1f2937;
    font-size: 0.95rem;
}

.conv-preview {
    font-size: 0.85rem;
    color: #9ca3af;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.unread-badge {
    background: #ef4444;
    color: white;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
}

.messages-main {
    display: flex;
    flex-direction: column;
}

.messages-header-main {
    padding: 1.5rem;
    border-bottom: 2px solid #e5e7eb;
    background: #f9fafb;
}

.conversation-header h2 {
    color: #1a3a52;
    margin: 0;
    font-size: 1.25rem;
}

.contact-info {
    color: #9ca3af;
    font-size: 0.9rem;
    margin: 0.25rem 0 0 0;
}

.messages-list {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.message {
    display: flex;
    gap: 1rem;
    animation: slideInUp 0.3s ease-out;
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.message.received {
    justify-content: flex-start;
}

.message.sent {
    justify-content: flex-end;
}

.message-avatar {
    font-size: 1.5rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.message-content {
    max-width: 60%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
}

.message.received .message-content {
    background: #e5e7eb;
    color: #1f2937;
}

.message.sent .message-content {
    background: #0066cc;
    color: white;
}

.message-content p {
    margin: 0;
    line-height: 1.4;
}

.message-time {
    display: block;
    font-size: 0.75rem;
    opacity: 0.7;
    margin-top: 0.5rem;
}

.message-input {
    padding: 1rem;
    border-top: 2px solid #e5e7eb;
    background: #f9fafb;
}

.input-group {
    display: flex;
    gap: 0.75rem;
}

.input-group input {
    flex: 1;
    padding: 0.75rem;
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    transition: all 0.3s ease;
}

.input-group input:focus {
    outline: none;
    border-color: #0066cc;
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
}

.btn-send {
    background: #0066cc;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.btn-send:hover {
    background: #0052a3;
    transform: translateY(-2px);
}

@media (max-width: 1024px) {
    .messages-container {
        grid-template-columns: 200px 1fr;
    }

    .message-content {
        max-width: 80%;
    }
}

@media (max-width: 768px) {
    .page-messages {
        height: auto;
    }

    .messages-container {
        grid-template-columns: 1fr;
        height: 600px;
    }

    .messages-sidebar {
        display: none;
    }

    .message-content {
        max-width: 80%;
    }
}
        </ul>
    </div>

    <div class="messages-content">
        <div class="message-header">
            <h3>Konverzace</h3>
            <button class="btn-small">Smaž rozhovor</button>
        </div>

        <div class="messages-list">
            <div class="message received">
                <p>Příklad zprávy od učitele</p>
                <span class="message-time">10:30</span>
            </div>
            <div class="message sent">
                <p>Příklad vaší odpovědi</p>
                <span class="message-time">10:35</span>
            </div>
            <div class="message received">
                <p>Další zpráva z komunikace</p>
                <span class="message-time">10:36</span>
            </div>
        </div>

        <div class="message-input-area">
            <textarea placeholder="Napište vaši zprávu..."></textarea>
            <button class="btn-primary">Poslat</button>
        </div>
    </div>
</div>
