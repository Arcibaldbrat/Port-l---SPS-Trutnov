@page
@using Port_SPS.Pages
@model IndexModel
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Domů - SPS Trutnov";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-background"></div>
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">📚 Portál SPS Trutnov</h1>
            <p class="hero-subtitle">Střední průmyslová škola Trutnov</p>
            <p class="hero-description">Moderní vzdělávací portál pro studenty, učitele a veřejnost</p>

            @if (!(User.Identity?.IsAuthenticated ?? false))
            {
                <div class="hero-buttons">
                    <a asp-page="/Auth/Login" class="btn-hero btn-hero-primary">
                        <span class="btn-icon">🔐</span> Přihlásit se
                    </a>
                    <a asp-page="/Auth/Register" class="btn-hero btn-hero-secondary">
                        <span class="btn-icon">✍️</span> Zaregistrovat se
                    </a>
                </div>
            }
            else
            {
                <div class="hero-buttons">
                    <a asp-page="/Dashboard" class="btn-hero btn-hero-primary">
                        <span class="btn-icon">📊</span> Na dashboard
                    </a>
                    <a asp-page="/Profile/Index" class="btn-hero btn-hero-secondary">
                        <span class="btn-icon">👤</span> Můj profil
                    </a>
                </div>
            }
        </div>
        <div class="hero-image">
            <div class="hero-decoration">🏫</div>
        </div>
    </div>
</section>

<!-- AUTHENTICATED USER WELCOME -->
@if (User.Identity?.IsAuthenticated ?? false)
{
    <section class="welcome-section">
        <div class="container-lg">
            <div class="welcome-card">
                <div class="welcome-icon">👋</div>
                <h2>Vítejte, <strong>@Model.CurrentUser?.FirstName @Model.CurrentUser?.LastName</strong>!</h2>
                <p class="welcome-role">Vaše role: <strong>@Model.CurrentUser?.Role</strong></p>
                <p class="welcome-message">Jste připraveni začít? Vyberte si jednu z níže uvedených akcí.</p>
            </div>
        </div>
    </section>

    <section class="quick-access-section">
        <div class="container-lg">
            <h2 class="section-title">🚀 Rychlý přístup</h2>
            <div class="quick-access-grid">
                <a asp-page="/Dashboard" class="quick-access-card">
                    <div class="qa-icon">📊</div>
                    <h3>Dashboard</h3>
                    <p>Přehled vašich nejdůležitějších informací</p>
                    <span class="qa-arrow">→</span>
                </a>

                @if (Model.CurrentUser?.Role == "Student")
                {
                    <a asp-page="/Student/Grades" class="quick-access-card">
                        <div class="qa-icon">📈</div>
                        <h3>Mé známky</h3>
                        <p>Zobrazit vaše školní výsledky a průměr</p>
                        <span class="qa-arrow">→</span>
                    </a>

                    <a asp-page="/Schedule" class="quick-access-card">
                        <div class="qa-icon">🗓️</div>
                        <h3>Rozvrh hodin</h3>
                        <p>Podívejte se na váš rozvrh hodin</p>
                        <span class="qa-arrow">→</span>
                    </a>

                    <a asp-page="/Messages" class="quick-access-card">
                        <div class="qa-icon">💬</div>
                        <h3>Zprávy</h3>
                        <p>Komunikace s učiteli a spolužáky</p>
                        <span class="qa-arrow">→</span>
                    </a>
                }

                @if (Model.CurrentUser?.Role == "Teacher")
                {
                    <a asp-page="/Teacher/Classes" class="quick-access-card">
                        <div class="qa-icon">👥</div>
                        <h3>Mé třídy</h3>
                        <p>Spravujte své třídy a studenty</p>
                        <span class="qa-arrow">→</span>
                    </a>

                    <a asp-page="/Schedule" class="quick-access-card">
                        <div class="qa-icon">🗓️</div>
                        <h3>Rozvrh</h3>
                        <p>Přehled vašeho rozvrhu hodin</p>
                        <span class="qa-arrow">→</span>
                    </a>

                    <a asp-page="/Messages" class="quick-access-card">
                        <div class="qa-icon">💬</div>
                        <h3>Zprávy</h3>
                        <p>Komunikace se studenty a kolegy</p>
                        <span class="qa-arrow">→</span>
                    </a>
                }

                <a asp-page="/Profile/Index" class="quick-access-card">
                    <div class="qa-icon">👤</div>
                    <h3>Profil</h3>
                    <p>Spravujte své osobní údaje</p>
                    <span class="qa-arrow">→</span>
                </a>
            </div>
        </div>
    </section>
}

<!-- PUBLIC INFORMATION SECTION (always visible) -->
<section class="info-section">
    <div class="container-lg">
        <h2 class="section-title">ℹ️ O Naší Škole</h2>

        <div class="info-grid">
            <div class="info-card">
                <div class="info-icon">🎓</div>
                <h3>Kvalitní Vzdělání</h3>
                <p>Poskytujeme moderní vzdělání v oblasti průmyslu, IT a technologií s certifikovanými učiteli a praktickým zaměřením.</p>
            </div>

            <div class="info-card">
                <div class="info-icon">💻</div>
                <h3>Moderní Vybavení</h3>
                <p>Jsme vybaveni nejnovější technologií, laboratorními prostředky a počítačovými sálami pro praktické výuky.</p>
            </div>

            <div class="info-card">
                <div class="info-icon">🌐</div>
                <h3>Spolupráce se Průmyslem</h3>
                <p>Úzká spolupráce s průmyslovými podniky poskytuje studentům zkušenosti a perspektivu na pracovní trh.</p>
            </div>

            <div class="info-card">
                <div class="info-icon">🏆</div>
                <h3>Úspěchy Studentů</h3>
                <p>Naši studenti dosahují vynikajících výsledků v soutěžích, přijímacích zkouškách a následně na vysokých školách.</p>
            </div>

            <div class="info-card">
                <div class="info-icon">👥</div>
                <h3>Podpůrné Prostředí</h3>
                <p>Vytváříme přátelské a bezpečné prostředí, kde se každý student může rozvíjet a dosahovat svých cílů.</p>
            </div>

            <div class="info-card">
                <div class="info-icon">📚</div>
                <h3>Cihlokod Vzdělání</h3>
                <p>Nabízíme jak teoretické znalosti, tak praktické dovednosti potřebné pro úspěch v moderní společnosti.</p>
            </div>
        </div>
    </div>
</section>

<!-- STATISTICS SECTION -->
<section class="stats-section">
    <div class="container-lg">
        <h2 class="section-title">📊 Naše Čísla</h2>

        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-number">800+</div>
                <div class="stat-label">Studentů</div>
                <div class="stat-desc">Vzdělává se s námi</div>
            </div>

            <div class="stat-box">
                <div class="stat-number">50+</div>
                <div class="stat-label">Učitelů</div>
                <div class="stat-desc">Kvalifikovaných pedagogů</div>
            </div>

            <div class="stat-box">
                <div class="stat-number">30+</div>
                <div class="stat-label">Oborů</div>
                <div class="stat-desc">K výběru</div>
            </div>

            <div class="stat-box">
                <div class="stat-number">95%</div>
                <div class="stat-label">Uplaćení</div>
                <div class="stat-desc">Absolventi na trhu práce</div>
            </div>
        </div>
    </div>
</section>

<!-- PROGRAMS SECTION -->
<section class="programs-section">
    <div class="container-lg">
        <h2 class="section-title">📖 Naše Obory</h2>

        <div class="programs-grid">
            <div class="program-card">
                <div class="program-icon">⚙️</div>
                <h3>Stavebnictví</h3>
                <p>Vzdělání v oboru stavebnictví s zaměřením na stavební projekty a konstrukční řešení.</p>
                <div class="program-duration">3-4 roky</div>
            </div>

            <div class="program-card">
                <div class="program-icon">💻</div>
                <h3>Informatika a IT</h3>
                <p>Moderní vzdělání v programování, webových technologiích a správě informačních systémů.</p>
                <div class="program-duration">3-4 roky</div>
            </div>

            <div class="program-card">
                <div class="program-icon">🔧</div>
                <h3>Strojnictví</h3>
                <p>Praktické vzdělání v oblasti strojnictví, automechaniky a průmyslové techniky.</p>
                <div class="program-duration">3-4 roky</div>
            </div>

            <div class="program-card">
                <div class="program-icon">⚡</div>
                <h3>Elektrotechnika</h3>
                <p>Vzdělání v elektrotechnice, elektrikářství a elektrotechnických instalacích.</p>
                <div class="program-duration">3-4 roky</div>
            </div>

            <div class="program-card">
                <div class="program-icon">🏗️</div>
                <h3>Stavbyvedení</h3>
                <p>Příprava vedoucích pracovníků staveb s managementem a organizací stavebních prací.</p>
                <div class="program-duration">2 roky</div>
            </div>

            <div class="program-card">
                <div class="program-icon">🎨</div>
                <h3>Design a Grafika</h3>
                <p>Tvůrčí přístup k designu, grafice a vizuální komunikaci v digitálním věku.</p>
                <div class="program-duration">3-4 roky</div>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS SECTION -->
<section class="testimonials-section">
    <div class="container-lg">
        <h2 class="section-title">💬 Vzkazy Absolventů</h2>

        <div class="testimonials-grid">
            <div class="testimonial-card">
                <div class="testimonial-header">
                    <div class="testimonial-avatar">👨‍💼</div>
                    <div class="testimonial-name">
                        <strong>Jan Novotný</strong>
                        <span class="testimonial-role">IT Specialista</span>
                    </div>
                </div>
                <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
                <p class="testimonial-text">SPS Trutnov mi dala skvělý základ v programování. Dnes pracuji jako developer a mohu říci, že vzdělání bylo perfektní příprava na reálný svět.</p>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-header">
                    <div class="testimonial-avatar">👩‍🔧</div>
                    <div class="testimonial-name">
                        <strong>Marie Svobodová</strong>
                        <span class="testimonial-role">Stavbyvedoucí</span>
                    </div>
                </div>
                <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
                <p class="testimonial-text">Praktický přístup k výuce v SPS Trutnov bylo přesně to, co jsem potřebovala. Dnes vést tým na stavbě a cítím, že jsem dobře připravena.</p>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-header">
                    <div class="testimonial-avatar">👨‍🏭</div>
                    <div class="testimonial-name">
                        <strong>Petr Dvořák</strong>
                        <span class="testimonial-role">Elektrikář</span>
                    </div>
                </div>
                <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
                <p class="testimonial-text">Vzdělání v elektrotechnice na SPS bylo kvalitní a praxe-orientované. Teď mám vlastní firmu a jsem vděčný za všechny znalosti.</p>
            </div>
        </div>
    </div>
</section>

<!-- FEATURES SECTION -->
<section class="features-section">
    <div class="container-lg">
        <h2 class="section-title">✨ Výhody Portálu</h2>

        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">🔒</div>
                <h4>Bezpečný Přístup</h4>
                <p>Všechny vaše osobní data jsou chráněna moderním šifrováním a bezpečnostními protokoly.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon">📱</div>
                <h4>Responsive Design</h4>
                <p>Portál je optimalizován pro všechna zařízení - počítače, tablety i telefony.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon">⚡</div>
                <h4>Rychlý a Efektivní</h4>
                <p>Čistá a intuitivní rozhraní umožňuje snadnou navigaci a rychlé hledání informací.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon">24/7</div>
                <h4>Vždy Dostupný</h4>
                <p>Přístupujte k portálu kdykoli a odkudkoli v průběhu školního roku.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon">💬</div>
                <h4>Komunikace</h4>
                <p>Snadná komunikace mezi studenty, učiteli a vedením školy prostřednictvím portálu.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon">📊</div>
                <h4>Přehledné Údaje</h4>
                <p>Jednoduše si ověřte své známky, rozvrh a další důležité informace.</p>
            </div>
        </div>
    </div>
</section>

