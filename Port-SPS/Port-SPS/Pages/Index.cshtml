        <h2 class="section-title">🏆 Naše Úspěchy</h2>

        <div class="achievements-list">
            <div class="achievement-item">
                <div class="achievement-icon">🥇</div>
                <div class="achievement-content">
                    <h3>Nejlepší Technická Škola 2023</h3>
