<!-- CTA SECTION (for non-authenticated users) -->
@if (!(User.Identity?.IsAuthenticated ?? false))
{
    <section class="cta-section">
        <div class="container-lg">
            <div class="cta-content">
                <h2>Připraveni na start?</h2>
                <p>Registrujte se nebo se přihlaste do portálu a získejte přístup ke všem funkcím.</p>
                <div class="cta-buttons">
                    <a asp-page="/Auth/Register" class="btn-cta btn-cta-primary">
                        <span class="cta-icon">✍️</span> Zaregistrovat se
                    </a>
                    <a asp-page="/Auth/Login" class="btn-cta btn-cta-secondary">
                        <span class="cta-icon">🔐</span> Přihlásit se
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<!-- EVENTS SECTION -->
