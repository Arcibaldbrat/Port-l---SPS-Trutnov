@page
@using Port_SPS.Pages.Profile
@model IndexModel
@{
    ViewData["Title"] = "Můj profil";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Jméno:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.CurrentUser?.FirstName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Příjmení:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.CurrentUser?.LastName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Email:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.CurrentUser?.Email
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Role:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.CurrentUser?.Role
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Účet vytvořen:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.CurrentUser?.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Status:</strong>
                        </div>
                        <div class="col-md-8">
                            @if (Model.CurrentUser?.IsApproved ?? false)
                            {
                                <span class="badge bg-success">Aktivní</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Čeká na schválení</span>
                            }
                        </div>
                    </div>

                    <hr />
                    <a asp-page="./Edit" class="btn btn-primary">Upravit profil</a>
                    <a asp-page="./ChangePassword" class="btn btn-secondary">Změna hesla</a>
                </div>
            </div>
        </div>
    </div>
</div>
