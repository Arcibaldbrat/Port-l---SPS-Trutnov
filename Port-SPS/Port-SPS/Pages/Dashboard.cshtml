@page
@using Port_SPS.Pages
@model DashboardModel
@{
    ViewData["Title"] = "Přehled";
}

<!-- Dashboard Section -->
<section id="dashboard" class="section active">
    <h2>📊 Přehled</h2>
    
    <div class="dashboard-grid">
        <!-- Quick Stats -->
        <div class="card stats-card">
            <h3>Statistika</h3>
            <div class="stats-grid">
                <div class="stat">
                    <span class="stat-number">-</span>
                    <span class="stat-label">Průměr známek</span>
                </div>
                <div class="stat">
                    <span class="stat-number">-</span>
                    <span class="stat-label">Nečtené zprávy</span>
                </div>
                <div class="stat">
                    <span class="stat-number">-</span>
                    <span class="stat-label">Domácí úkoly</span>
                </div>
                <div class="stat">
                    <span class="stat-number">-</span>
                    <span class="stat-label">Docházka</span>
                </div>
            </div>
        </div>

        <!-- Upcoming Events -->
        <div class="card">
            <h3>🗓️ Nadcházející akce</h3>
            <ul class="event-list">
                <li>
                    <span class="event-date">XX.XX.</span>
                    <span class="event-title">Plánovaná akce</span>
                </li>
                <li>
                    <span class="event-date">XX.XX.</span>
                    <span class="event-title">Plánovaná aktivita</span>
                </li>
                <li>
                    <span class="event-date">XX.XX.</span>
                    <span class="event-title">Plánovaná událost</span>
                </li>
                <li>
                    <span class="event-date">XX.XX.</span>
                    <span class="event-title">Plánovaná akce</span>
                </li>
            </ul>
        </div>

        <!-- Latest Grades -->
        <div class="card">
            <h3>📊 Poslední známky</h3>
            <p style="color: #9ca3af; text-align: center; padding: 2rem;">Vaše poslední známky se zobrazí zde</p>
        </div>

        <!-- Messages Preview -->
        <div class="card">
            <h3>💬 Poslední zprávy</h3>
            <ul class="message-list">
                <li>
                    <strong>Systém:</strong> Vítejte na portálu!
                </li>
            </ul>
        </div>

        <!-- Homework -->
        <div class="card">
            <h3>✏️ Domácí úkoly</h3>
            <p style="color: #9ca3af; text-align: center; padding: 1rem;">Vaše domácí úkoly se zobrazí zde</p>
        </div>

        <!-- Attendance -->
        <div class="card">
            <h3>📋 Docházka</h3>
            <p style="color: #9ca3af; text-align: center; padding: 1rem;">Vaše docházka se zobrazí zde</p>
        </div>
    </div>
</section>
