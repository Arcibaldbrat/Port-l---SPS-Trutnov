@page
@using Port_SPS.Pages
@model MaterialsModel
@{
    ViewData["Title"] = "Materiály - SPS Trutnov";
}

<div class="page-materials">
    <div class="materials-header">
        <h1>📚 Studijní materiály</h1>
        <p class="materials-subtitle">Sbírka učebních textů, příkladů a dalších studijních pomůcek</p>
    </div>

    <div class="materials-container">
        <div class="materials-category">
            <div class="category-header">
                <h2>📐 Matematika</h2>
            </div>
            <ul class="materials-list">
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">📄</span>
                        <div>
                            <h3>Sbírka příkladů - Kvadratické rovnice</h3>
                            <p>Rozsáhlá sbírka 50+ příkladů na řešení kvadratických rovnic s řešením</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">📋</span>
                        <div>
                            <h3>Studijní materiál - Funkce</h3>
                            <p>Detailní vysvětlení funkcí, jejich vlastností a grafů</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">✏️</span>
                        <div>
                            <h3>Pracovní list - Limity</h3>
                            <p>Pracovní listy na procvičení limit s postupným řešením</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (DOCX)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">📊</span>
                        <div>
                            <h3>Prezentace - Kombinatorika</h3>
                            <p>Interaktivní prezentace na kombinatoriku s příklady</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PPTX)</button>
                </li>
            </ul>
        </div>

        <div class="materials-category">
            <div class="category-header">
                <h2>📖 Čeština</h2>
            </div>
            <ul class="materials-list">
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">📚</span>
                        <div>
                            <h3>Analýza - Rusalka (S. K. Neumann)</h3>
                            <p>Detailná literární analýza básní z výboru Rusalka</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">✍️</span>
                        <div>
                            <h3>Návod na psaní eseje</h3>
                            <p>Podrobný průvodce psaním eseje s příklady dobré práce</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (DOCX)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">🎯</span>
                        <div>
                            <h3>Příprava na závěrečný test</h3>
                            <p>Soupis všech důležitých témat a typových otázek</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
            </ul>
        </div>

        <div class="materials-category">
            <div class="category-header">
                <h2>🌐 Anglický jazyk</h2>
            </div>
            <ul class="materials-list">
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">🎧</span>
                        <div>
                            <h3>Audio nahrávky - rozhovory</h3>
                            <p>Sbírka 20 autentických anglických rozhovorů pro poslech</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (ZIP)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">📝</span>
                        <div>
                            <h3>Slovní zásoba - Business English</h3>
                            <p>Klíčová slovní zásoba pro obchodní komunikaci</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">🔤</span>
                        <div>
                            <h3>Gramatika - Present Perfect</h3>
                            <p>Vysvětlení Present Perfect s cvičením</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
            </ul>
        </div>

        <div class="materials-category">
            <div class="category-header">
                <h2>💻 Informatika</h2>
            </div>
            <ul class="materials-list">
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">🖥️</span>
                        <div>
                            <h3>Programování v C# - Základy</h3>
                            <p>Úvod do programování s příklady a cvičeními</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">🗄️</span>
                        <div>
                            <h3>SQL - Dotazy a databáze</h3>
                            <p>Průvodce SQL s příklady reálných dotazů</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
                <li class="material-item">
                    <div class="material-info">
                        <span class="material-icon">🌐</span>
                        <div>
                            <h3>Web design - HTML a CSS</h3>
                            <p>Kompletní průvodce tvorbou webových stránek</p>
                        </div>
                    </div>
                    <button class="btn-download">⬇️ Stáhnout (PDF)</button>
                </li>
            </ul>
        </div>
    </div>
</div>

<style>
.page-materials {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
}

.materials-header {
    text-align: center;
    margin-bottom: 2rem;
}

.materials-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1a3a52;
    margin-bottom: 0.5rem;
}

.materials-subtitle {
    font-size: 1.1rem;
    color: #6b7280;
}

.materials-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.materials-category {
    background: white;
    padding: 2rem;
    border-radius: 0.75rem;
    border-left: 5px solid #0066cc;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.materials-category:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
}

.category-header h2 {
    color: #1a3a52;
    font-size: 1.5rem;
    margin: 0 0 1.5rem 0;
    font-weight: 600;
}

.materials-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.material-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem;
    background: #f9fafb;
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
    gap: 1rem;
}

.material-item:hover {
    background: #f3f4f6;
    border-color: #0066cc;
}

.material-info {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    flex: 1;
}

.material-icon {
    font-size: 1.75rem;
    min-width: 2rem;
    text-align: center;
}

.material-item h3 {
    color: #1a3a52;
    font-size: 1rem;
    margin: 0 0 0.25rem 0;
    font-weight: 600;
}

.material-item p {
    color: #6b7280;
    font-size: 0.9rem;
    margin: 0;
}

.btn-download {
    background: linear-gradient(135deg, #0066cc 0%, #004da6 100%);
    color: white;
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(0, 102, 204, 0.2);
}

.btn-download:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 102, 204, 0.3);
}

@media (max-width: 768px) {
    .materials-header h1 {
        font-size: 1.75rem;
    }

    .material-item {
        flex-direction: column;
        align-items: flex-start;
    }

    .btn-download {
        width: 100%;
        text-align: center;
    }
}
            <li>
                <span>✏️ Pracovní list - Limity</span>
                <button class="btn-download">Stáhnout</button>
            </li>
        </ul>
    </div>

    <div class="materials-list">
        <h3>Čeština</h3>
        <ul>
            <li>
                <span>📚 Analýza - Rusalka (S. K. Neumann)</span>
                <button class="btn-download">Stáhnout</button>
            </li>
            <li>
                <span>✍️ Návod na psaní eseje</span>
                <button class="btn-download">Stáhnout</button>
            </li>
            <li>
                <span>🎯 Příprava na závěrečný test</span>
                <button class="btn-download">Stáhnout</button>
            </li>
        </ul>
    </div>

    <div class="materials-list">
        <h3>Anglický jazyk</h3>
        <ul>
            <li>
                <span>🎧 Audio nahrávky - rozhovory</span>
                <button class="btn-download">Stáhnout</button>
            </li>
            <li>
                <span>📖 Slovní zásoba - Business English</span>
                <button class="btn-download">Stáhnout</button>
            </li>
            <li>
                <span>📝 Gramatika - Present Perfect</span>
                <button class="btn-download">Stáhnout</button>
            </li>
        </ul>
    </div>

    <div class="materials-list">
        <h3>Informatika</h3>
        <ul>
            <li>
                <span>💻 Tutorial - HTML5 a CSS3</span>
                <button class="btn-download">Stáhnout</button>
            </li>
            <li>
                <span>🐍 Python zadání projektů</span>
                <button class="btn-download">Stáhnout</button>
            </li>
            <li>
                <span>🗄️ Databáze - SQL příklady</span>
                <button class="btn-download">Stáhnout</button>
            </li>
        </ul>
    </div>
</div>
