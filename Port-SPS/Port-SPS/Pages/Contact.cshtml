@page
@using Port_SPS.Pages
@model ContactModel
@{
    ViewData["Title"] = "Kontakty - SPS Trutnov";
}

<div class="page-container">
    <h1 class="page-title">📞 Kontakty</h1>

    <section class="content-section">
        <p class="intro-text">
            Kontaktujte nás jakýmkoliv ze způsobů uvedených níže. Rádi vám zodpovíme veškeré vaše 
            dotazy ohledně naší školy.
        </p>
    </section>

    <div class="contact-grid">
        <section class="contact-section">
            <h2>📍 Adresa školy</h2>
            <div class="info-box">
                <p><strong>Střední průmyslová škola Trutnov</strong></p>
                <p>Benešova 1234</p>
                <p>541 01 Trutnov</p>
                <p>Česká republika</p>
            </div>
        </section>

        <section class="contact-section">
            <h2>📱 Telefonní kontakt</h2>
            <div class="info-box">
                <p><strong>Hlavní linka:</strong></p>
                <p><a href="tel:+420499801234">+420 499 801 234</a></p>
                <p style="margin-top: 1rem;"><strong>Ředitelna:</strong></p>
                <p><a href="tel:+420499801235">+420 499 801 235</a></p>
                <p style="margin-top: 1rem;"><strong>Sekretariát:</strong></p>
                <p><a href="tel:+420499801236">+420 499 801 236</a></p>
            </div>
        </section>

        <section class="contact-section">
            <h2>✉️ E-mail</h2>
            <div class="info-box">
                <p><strong>Obecné dotazy:</strong></p>
                <p><a href="mailto:info@spstrutnov.cz">info@spstrutnov.cz</a></p>
                <p style="margin-top: 1rem;"><strong>Ředitel:</strong></p>
                <p><a href="mailto:reditel@spstrutnov.cz">reditel@spstrutnov.cz</a></p>
                <p style="margin-top: 1rem;"><strong>Technická podpora:</strong></p>
                <p><a href="mailto:support@spstrutnov.cz">support@spstrutnov.cz</a></p>
            </div>
        </section>

        <section class="contact-section">
            <h2>🕐 Otevírací doba</h2>
            <div class="info-box">
                <p><strong>Pondělí - Pátek:</strong></p>
                <p>7:00 - 16:00</p>
                <p style="margin-top: 1rem;"><strong>Sobota - Neděle:</strong></p>
                <p>Zavřeno</p>
                <p style="margin-top: 1rem; font-size: 0.9rem; color: #666;">
                    * V létě upravená doba. Více informací na infolince.
                </p>
            </div>
        </section>
    </div>

    <section class="content-section">
        <h2>🗺️ Jak nás najdete</h2>
        <p>
            Naše škola se nachází v centru Trutnova, nedaleko hlavního náměstí. 
            Snadno se k nám dostanete autobusem nebo vlakem. V blízkosti školy 
            se nachází parkovací plocha pro vozidla rodičů a návštěvníků.
        </p>
        <div class="directions">
            <p>📍 <strong>Nejbližší zastávka MHD:</strong> Trutnov - Třída Svobody (100m)</p>
            <p>🚂 <strong>Vlakové nádraží:</strong> Trutnov hlavní nádraží (800m)</p>
            <p>🅿️ <strong>Parkoviště:</strong> K dispozici na školním pozemku</p>
        </div>
    </section>

    <section class="content-section">
        <h2>✉️ Napište nám zprávu</h2>
        <p>Máte konkrétní dotaz? Vyplňte formulář níže a my vám co nejdříve odpovíme.</p>

        <form class="contact-form" method="post" asp-page="Contact">
            <div class="form-group">
                <label for="name">Jméno a příjmení *</label>
                <input type="text" id="name" name="name" required>
            </div>

            <div class="form-group">
                <label for="email">E-mail *</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="phone">Telefon</label>
                <input type="tel" id="phone" name="phone">
            </div>

            <div class="form-group">
                <label for="subject">Předmět zprávy *</label>
                <select id="subject" name="subject" required>
                    <option value="">-- Zvolte předmět --</option>
                    <option value="admission">Přijetí do školy</option>
                    <option value="curriculum">Učební plán</option>
                    <option value="facilities">Vybavení školy</option>
                    <option value="scholarships">Stipendia a podpory</option>
                    <option value="events">Akce a schůzky</option>
                    <option value="other">Jiné</option>
                </select>
            </div>

            <div class="form-group">
                <label for="message">Zpráva *</label>
                <textarea id="message" name="message" rows="5" required></textarea>
            </div>

            <button type="submit" class="btn-submit">📧 Odeslat zprávu</button>
        </form>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="margin-top: 1rem;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }
    </section>

    <section class="content-section">
        <h2>🤝 Sociální sítě</h2>
        <p>Sledujte nás na sociálních sítích pro nejnovější informace a fotky ze školy:</p>
        <div class="social-links">
            <a href="https://www.facebook.com/spstrutnov" target="_blank" class="social-link">📘 Facebook</a>
            <a href="https://www.instagram.com/spstrutnov" target="_blank" class="social-link">📷 Instagram</a>
            <a href="https://www.youtube.com/spstrutnov" target="_blank" class="social-link">▶️ YouTube</a>
        </div>
    </section>
</div>

<style>
.page-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
}

.page-title {
    font-size: 2.5rem;
    color: #1a3a52;
    text-align: center;
    margin-bottom: 3rem;
    font-weight: bold;
}

.content-section {
    background: #f8f9fa;
    padding: 2rem;
    margin-bottom: 2rem;
    border-radius: 8px;
    border-left: 4px solid #0066cc;
}

.intro-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
}

.contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.contact-section {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
    border-left: 4px solid #0066cc;
}

.contact-section h2 {
    color: #1a3a52;
    margin-bottom: 1rem;
    font-size: 1.3rem;
}

.info-box {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.info-box p {
    margin: 0.5rem 0;
    color: #333;
}

.info-box a {
    color: #0066cc;
    text-decoration: none;
    font-weight: bold;
}

.info-box a:hover {
    text-decoration: underline;
}

.directions {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    margin-top: 1rem;
}

.directions p {
    padding: 0.5rem 0;
    color: #333;
}

.contact-form {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: bold;
    color: #333;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    font-family: inherit;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #0066cc;
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
}

.btn-submit {
    background: #0066cc;
    color: white;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease;
}

.btn-submit:hover {
    background: #0052a3;
}

.alert {
    padding: 1rem;
    border-radius: 4px;
}

.alert-success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
}

.social-link {
    display: inline-block;
    background: #0066cc;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    transition: background 0.3s ease;
}

.social-link:hover {
    background: #0052a3;
}
</style>
