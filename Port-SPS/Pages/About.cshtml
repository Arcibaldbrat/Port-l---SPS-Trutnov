@page
@model AboutModel
@{
    ViewData["Title"] = "O škole - SPS Trutnov";
}

<div class="page-container">
    <h1>ℹ️ O naší škole</h1>

    <section class="content-section">
        <h2>Střední průmyslová škola Trutnov</h2>
        <p>Vítejte na oficiálním portálu Střední průmyslové školy Trutnov. Jsme prestižní vzdělávací institucí zaměřenou na výuku moderních technologií a řemesel.</p>
    </section>

    <section class="content-section">
        <h2>Naše mise</h2>
        <div class="info-cards">
            <div class="info-card">
                <div class="icon">🎓</div>
                <h3>Kvalitní vzdělání</h3>
                <p>Poskytujeme moderní a relevantní vzdělání se zaměřením na praktické dovednosti.</p>
            </div>
            <div class="info-card">
                <div class="icon">🔧</div>
                <h3>Praktická praxe</h3>
                <p>Naši studenti získávají cenné zkušenosti v reálných pracovních prostředích.</p>
            </div>
            <div class="info-card">
                <div class="icon">💼</div>
                <h3>Kariérní perspektivy</h3>
                <p>Pomáháme našim studentům najít vyhovující zaměstnání nebo pokračovat v dalším studiu.</p>
            </div>
        </div>
    </section>

    <section class="content-section">
        <h2>Obory vzdělání</h2>
        <ul class="feature-list">
            <li>📱 Informační technologie</li>
            <li>⚙️ Strojnictví a automechanika</li>
            <li>🏗️ Stavebnictví</li>
            <li>💡 Elektrotechnika</li>
            <li>👨‍💼 Obchod a služby</li>
            <li>🎨 Grafika a design</li>
        </ul>
    </section>

    <section class="content-section">
        <h2>Naše škola v číslech</h2>
        <div class="stats">
            <div class="stat-box">
                <div class="stat-number">500+</div>
                <div class="stat-label">Studentů</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">50+</div>
                <div class="stat-label">Učitelů</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">6</div>
                <div class="stat-label">Oborů</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">30+</div>
                <div class="stat-label">Let tradice</div>
            </div>
        </div>
    </section>
</div>

<style>
.page-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
}

.page-container h1 {
    font-size: 2.5rem;
    color: #1a3a52;
    text-align: center;
    margin-bottom: 2rem;
}

.content-section {
    background: white;
    padding: 2rem;
    margin-bottom: 2rem;
    border-radius: 8px;
    border-left: 5px solid #0066cc;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.content-section h2 {
    color: #1a3a52;
    margin-bottom: 1rem;
}

.info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.info-card {
    background: #f9fafb;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
}

.info-card .icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.info-card h3 {
    color: #0066cc;
    margin-bottom: 0.5rem;
}

.feature-list {
    list-style: none;
    padding: 0;
}

.feature-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid #e5e7eb;
    color: #333;
}

.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
}

.stat-box {
    background: linear-gradient(135deg, #0066cc 0%, #004da6 100%);
    color: white;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
}

.stat-number {
    font-size: 2rem;
    font-weight: bold;
}

.stat-label {
    font-size: 0.95rem;
    opacity: 0.95;
    margin-top: 0.5rem;
}

@media (max-width: 768px) {
    .page-container h1 {
        font-size: 1.75rem;
    }
}
</style>
